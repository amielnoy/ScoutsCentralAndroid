<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fillViewport="true"
  android:background="#F8F9FA"
  android:layoutDirection="rtl">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Section -->
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="התקדמות אישית"
      android:textSize="28sp"
      android:textStyle="bold"
      android:textColor="#1A1C1E" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="צרו מסלול מותאם אישית עבור החניכים שלכם בעזרת בינה מלאכותית."
      android:textColor="#44474E"
      android:textSize="14sp"
      android:layout_marginTop="4dp" />

    <!-- Input Card -->
    <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      app:cardCornerRadius="24dp"
      app:cardElevation="0dp"
      app:strokeWidth="1dp"
      app:strokeColor="#E1E2E9">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="פרטי החניך/ה"
          android:textStyle="bold"
          android:textColor="#1A1C1E"
          android:textSize="16sp" />

        <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          app:cardBackgroundColor="#F1F3F9"
          app:cardCornerRadius="12dp"
          app:cardElevation="0dp">
          <Spinner
            android:id="@+id/progress_scout_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingHorizontal="12dp" />
        </com.google.android.material.card.MaterialCardView>

        <EditText
          android:id="@+id/progress_positive_traits"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:hint="חוזקות ותחומי עניין (למשל: מנהיגות)"
          android:background="@drawable/activity_placeholder"
          android:backgroundTint="#F1F3F9"
          android:padding="14dp"
          android:minLines="2"
          android:gravity="top"
          android:textSize="14sp"
          android:inputType="textMultiLine" />

        <EditText
          android:id="@+id/progress_negative_traits"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:hint="אתגרים לשיפור (למשל: ביישנות)"
          android:background="@drawable/activity_placeholder"
          android:backgroundTint="#F1F3F9"
          android:padding="14dp"
          android:minLines="2"
          android:gravity="top"
          android:textSize="14sp"
          android:inputType="textMultiLine" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/progress_generate"
          android:layout_width="match_parent"
          android:layout_height="56dp"
          android:text="ייצור תוכנית בעזרת AI"
          android:layout_marginTop="24dp"
          app:cornerRadius="16dp"
          app:icon="@android:drawable/ic_menu_slideshow"
          style="@style/Widget.MaterialComponents.Button" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Enhanced AI Result Card -->
    <com.google.android.material.card.MaterialCardView
      android:id="@+id/progress_result_card"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      app:cardCornerRadius="28dp"
      app:cardElevation="6dp"
      app:cardBackgroundColor="@color/surface"
      app:strokeWidth="0dp">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top colored bar -->
        <View
          android:layout_width="match_parent"
          android:layout_height="6dp"
          android:background="@color/primary" />

        <androidx.constraintlayout.widget.ConstraintLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:padding="24dp">

          <ImageView
            android:id="@+id/ai_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/btn_star_big_on"
            app:tint="@color/primary"
            app:layout_constraintTop_toTopOf="@id/result_title"
            app:layout_constraintBottom_toBottomOf="@id/result_title"
            app:layout_constraintStart_toStartOf="parent" />

          <TextView
            android:id="@+id/result_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="תוכנית התקדמות מותאמת"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/primary"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/ai_icon" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/copy_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="0dp"
            app:icon="@android:drawable/ic_menu_save"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/text_secondary"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

          <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F0F0"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/result_title" />

          <!-- Side Indicator -->
          <View
            android:id="@+id/side_indicator"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:background="#E8F5E9"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintBottom_toBottomOf="@id/progress_result"
            app:layout_constraintStart_toStartOf="parent" />

          <TextView
            android:id="@+id/progress_result"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="התוצאה תופיע כאן..."
            android:textColor="#333333"
            android:textSize="16sp"
            android:lineSpacingExtra="10dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintStart_toEndOf="@id/side_indicator"
            app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <View
      android:layout_width="match_parent"
      android:layout_height="60dp" />

  </LinearLayout>
</ScrollView>
